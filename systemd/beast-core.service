[Unit]
Description=Beastagotchi Core Foundation
After=network.target pwnagotchi.service bettercap.service gpsd.socket
Wants=gpsd.socket

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/beast-core
ExecStart=/usr/bin/python3 -m beastcore --host 127.0.0.1 --port 8090 --db /var/lib/beastagotchi/beast.db
Restart=on-failure
RestartSec=3
# Core owns the volatile runtime root, while UI/Studio run as pi in the
# beastagotchi group and must be able to publish bounded runtime telemetry.
RuntimeDirectory=beastagotchi
RuntimeDirectoryMode=0775
RuntimeDirectoryPreserve=yes
ExecStartPre=/usr/bin/chgrp beastagotchi /run/beastagotchi
UMask=0027

# Foundation hardening: read-mostly daemon with narrowly defined writable paths.
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/beastagotchi /run/beastagotchi

[Install]
WantedBy=multi-user.target
